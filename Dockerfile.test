FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# System deps needed for R and rpy2 source compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl wget git \
        build-essential gcc \
        libcurl4-openssl-dev libssl-dev \
        libfontconfig1-dev libharfbuzz-dev libfribidi-dev \
        libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install R 4.4.1 from POSIT pre-built .deb (includes headers needed to compile rpy2)
RUN curl -fsSL -o /tmp/r-4.4.1_1_amd64.deb \
        https://cdn.rstudio.com/r/ubuntu-2404/pkgs/r-4.4.1_1_amd64.deb \
    && apt-get update \
    && apt-get install -y /tmp/r-4.4.1_1_amd64.deb \
    && rm /tmp/r-4.4.1_1_amd64.deb \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && ln -s /opt/R/4.4.1/bin/R      /usr/local/bin/R \
    && ln -s /opt/R/4.4.1/bin/Rscript /usr/local/bin/Rscript

ENV R_HOME=/opt/R/4.4.1/lib/R

# Install R packages required by Synthpop synthesizer
RUN Rscript -e "install.packages(c('synthpop', 'dplyr'), repos='https://cloud.r-project.org', quiet=TRUE)"

# Install uv (Python package/env manager) and pre-fetch Python 3.12
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh \
    && uv python install 3.12

# rpy2 must be compiled from source against R 4.4.1 (binary wheels link against a different R)
ENV RPY2_CFFI_MODE=ABI
ENV UV_NO_BINARY_PACKAGE=rpy2
