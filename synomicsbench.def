Bootstrap: docker
From: ubuntu:24.04

%files
  dist/synomicsbench-1.0.0-py3-none-any.whl /opt/synomicsbench-1.0.0-py3-none-any.whl  

%post
    # Setup NOW variable
    NOW=`date`
    echo "export NOW=\"${NOW}\"" >> $SINGULARITY_ENVIRONMENT

    # Base OS dependencies (no VS Code, no conda/miniforge)
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        git \
        build-essential \
        cmake \
        make \
        gcc \
        less \
        vim \
        nano \
        emacs \
        libcurl4-openssl-dev \
        libssl-dev \
        libfontconfig1-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        nodejs \
        npm \
        pciutils \
        nvtop

    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # Create bin directory
    mkdir -p /binary
    BIN=/binary

    # Install uv (let uv manage Python versions; do not install python3 via apt)
    # Install to /usr/local/bin so it's available for all users.
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

    # (Optional but recommended) Create a shared uv cache directory to avoid writing into $HOME at runtime.
    # You can remove this if your HPC policy prefers per-user caches.
    mkdir -p /opt/uv
    chmod 0777 /opt/uv

    # R 4.4.1 install from Deb package
    mkdir -p $BIN/r-4.4.1
    curl -L -o $BIN/r-4.4.1/r-4.4.1_1_amd64.deb https://cdn.rstudio.com/r/ubuntu-2404/pkgs/r-4.4.1_1_amd64.deb
    apt-get update
    apt-get install -y $BIN/r-4.4.1/r-4.4.1_1_amd64.deb
    rm -rf $BIN/r-4.4.1/r-4.4.1_1_amd64.deb
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    ln -s /opt/R/4.4.1/bin/R /usr/local/bin/R
    ln -s /opt/R/4.4.1/bin/Rscript /usr/local/bin/Rscript
    ln -s /opt/R/4.4.1/bin/R /usr/local/bin/R441
    ln -s /opt/R/4.4.1/bin/Rscript /usr/local/bin/Rscript441

    # Install Python via uv and synomicsbench
    export PATH=/usr/local/bin:$PATH
    export R_HOME=/opt/R/4.4.1/lib/R
    uv python install 3.12
    uv venv /opt/synomicsbench-env --python 3.12
    uv pip install --python /opt/synomicsbench-env/bin/python /opt/synomicsbench-1.0.0-py3-none-any.whl

%environment
    export BIN=/binary
    export R_HOME=/opt/R/4.4.1/lib/R
    export PATH=/opt/synomicsbench-env/bin:/usr/local/bin:$PATH
    export UV_CACHE_DIR=/opt/uv
    export UV_PYTHON_INSTALL_DIR=/opt/uv/python

%runscript
    echo "Container was created $NOW"
    echo "Argument received: $*"
    exec echo "$@"

%test
    less --version
    make --version
    gcc --version
    wget --version
    vim --version
    nano --version
    curl --version
    uv --version

%labels
    Author The-Chuong TRINH
    Version v20251102

%help
    Generic container for managing Python (via uv-managed Python versions) and R 4.4.1, suitable for SynOmics workflows.
